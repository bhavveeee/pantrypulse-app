{
  "functions": {
    "api/recipe.js": {
      "maxDuration": 60
    },
    "api/recipeadd.js": {
      "maxDuration": 60
    },
    "api/rasoi.js": {
      "maxDuration": 60
    },
    "api/emergent.js": {
      "maxDuration": 30
    },
    "api/sheet.js": {
      "maxDuration": 30
    },
    "api/pp.js": {
      "maxDuration": 60
    },
    "api/pplog.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/private/igho/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/private/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}